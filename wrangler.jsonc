{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save-the-discord",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
